datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  name         String?
  phone        String?
  role         String      @default("CUSTOMER") // CUSTOMER, STAFF, ADMIN, SUPER_ADMIN
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  addresses    Address[]
  orders       Order[]
  savedLooks   SavedLook[]
  reviews      Review[]
  aiJobs       AITryOnJob[]
  auditLogs    AuditLog[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  gender      String    // women, men, unisex
  imageUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                       String            @id @default(cuid())
  name                     String
  slug                     String            @unique
  description              String
  shortDescription         String?
  gender                   String            // women, men, unisex
  pricePaise               Int
  compareAtPricePaise      Int?
  costPricePaise           Int?              @default(0)
  shippingCostPaise        Int?              @default(7000)
  packagingCostPaise       Int?              @default(3000)
  otherExpensesPaise       Int?              @default(0)
  brand                    String            @default("XEVORAS")
  productType              String?           @default("Apparel")
  fabric                   String?
  material                 String?
  fit                      String?
  pattern                  String?
  occasion                 String?
  sleeveType               String?
  neckType                 String?
  careInstructions         String?
  keywords                 String?
  status                   String            @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  featured                 Boolean           @default(false)
  isNewArrival             Boolean           @default(false)
  isTrending               Boolean           @default(false)
  categoryId               String
  collectionId             String?
  sourcingType             String            @default("OWN") // OWN, ON_DEMAND, MEESHO
  supplierStatus           String            @default("VERIFIED") // NOT_VERIFIED, VERIFICATION_PENDING, AVAILABLE, OUT_OF_STOCK, TEMPORARILY_UNAVAILABLE
  supplierSourceUrl        String?
  supplierNotes            String?
  supplierVerificationDate DateTime?
  seoTitle                 String?
  seoDescription           String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  category                 Category          @relation(fields: [categoryId], references: [id])
  collection               Collection?       @relation(fields: [collectionId], references: [id])
  variants                 ProductVariant[]
  media                    ProductMedia[]
  resellingDetail          ResellingProduct?
  reviews                  Review[]
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  sku              String      @unique
  size             String
  colorName        String
  colorHex         String?
  stockCount       Int         @default(0)
  costPricePaise   Int?        @default(0)
  sellingPricePaise Int?       @default(0)
  variantImageUrl  String?
  status           String      @default("ACTIVE") // ACTIVE, INACTIVE
  availabilityMode String      @default("OWN_VERIFIED") // SUPPLIER_CHECK_REQUIRED, MANUALLY_CONFIRMED, OWN_VERIFIED
  available        Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  mediaType String   @default("image")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SupplierSource {
  id           String             @id @default(cuid())
  name         String
  contactName  String?
  contactPhone String?
  notes        String?
  active       Boolean            @default(true)

  products     ResellingProduct[]
}

model ResellingProduct {
  id                    String         @id @default(cuid())
  productId             String         @unique
  supplierSourceId      String
  supplierSku           String?
  supplierUrl           String?
  supplierCostPaise     Int
  estShippingCostPaise  Int            @default(7000)
  estPackagingCostPaise Int            @default(3000)
  platformFeePaise      Int            @default(0)
  fulfilmentNotes       String?
  stockVerifiedAt       DateTime?
  priceVerifiedAt       DateTime?

  product               Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSource        SupplierSource @relation(fields: [supplierSourceId], references: [id])
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  userId            String?
  guestEmail        String?
  guestPhone        String?
  shippingAddressId String?
  shippingDetailsJson String?
  subtotalPaise     Int
  discountPaise     Int             @default(0)
  taxPaise          Int             @default(0)
  shippingPaise     Int             @default(0)
  totalPaise        Int
  status            String          @default("CONFIRMED") // CONFIRMED, PACKED, SHIPPED, DELIVERED, CANCELLED, RETURNED
  sourcingStatus    String          @default("NOT_APPLICABLE") // NOT_APPLICABLE, TO_SOURCE, PURCHASED, SUPPLIER_SHIPPED, RECEIVED_QC_PASSED
  paymentMethod     String          @default("COD") // COD, PREPAID
  paymentStatus     String          @default("PENDING") // PENDING, COMPLETED, FAILED
  supplierOrderId   String?
  trackingNumber    String?
  trackingCarrier   String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User?           @relation(fields: [userId], references: [id])
  shippingAddress   Address?        @relation(fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  payment           Payment?
  shipments         Shipment[]
  returnRequests    ReturnRequest[]
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  variantId         String?
  productName       String
  slug              String?
  sku               String
  size              String
  color             String
  imageUrl          String?
  quantity          Int
  unitPricePaise    Int
  totalPricePaise   Int
  sourcingType      String          @default("OWN")
  supplierCostPaise Int?

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id               String   @id @default(cuid())
  orderId          String   @unique
  gateway          String   // RAZORPAY, CASHFREE, COD
  gatewayPaymentId String?
  amountPaise      Int
  status           String   @default("PENDING")
  rawResponse      String?
  createdAt        DateTime @default(now())

  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  carrier        String    // Delhivery, BlueDart
  trackingNumber String
  trackingUrl    String?
  status         String    @default("IN_TRANSIT")
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id                 String   @id @default(cuid())
  orderId            String
  reason             String
  comments           String?
  status             String   @default("PENDING")
  reverseTrackingNum String?
  refundPaise        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SavedLook {
  id               String   @id @default(cuid())
  userId           String?
  title            String
  avatarConfigJson String
  previewImageUrl  String?
  createdAt        DateTime @default(now())

  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AITryOnJob {
  id             String   @id @default(cuid())
  userId         String?
  productId      String
  userImageHash  String
  status         String   @default("PENDING")
  provider       String   @default("fashn-ai")
  resultImageUrl String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  user           User?    @relation(fields: [userId], references: [id])
}

model CMSContent {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  discountPercent   Int?
  discountFlatPaise Int?
  minOrderPaise     Int       @default(0)
  maxDiscountPaise  Int?
  active            Boolean   @default(true)
  expiresAt         DateTime?
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  userId             String?
  authorName         String
  city               String?
  rating             Int      @default(5)
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])
}

model ProductImportJob {
  id             String    @id @default(cuid())
  sourceUrl      String
  sourcePlatform String    @default("MEESHO")
  status         String    @default("DRAFT_CREATED") // PENDING, DRAFT_CREATED, COMPLETED, FAILED
  importNotes    String?
  draftProductId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  filename   String
  url        String   @unique
  mimeType   String
  sizeBytes  Int
  altText    String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
}
